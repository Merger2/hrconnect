n166:                     this.cleanup();\n167:                     await this.loadModels();\n168:                     await this.startCamera();\n169:                     this.startDetection();\n170:                     this.collectGpsSamples();\n171:                 } catch (error) {\n172:                     this.failHard('{{ __('Tidak dapat mengakses kamera.') }}');\n173:                 }\n174:             },\n175: \n176:             setStage(stage, message, hint = null) {\n177:                 this.status = stage;\n178:                 this.statusMessage = message;\n179:                 if (hint !== null) this.hintMessage = hint;\n180:             },\n181: \n182:             showSpinner() {\n\n(Showing lines 33-182 of 550. Use offset=183 to continue.)\n</content>","metadata":{"preview":"        </div>\n\n        {{-- Location & WFA Panel --}}\n        <section class=\"relative flex flex-col gap-4 overflow-hidden rounded-xl border border-outline-variant bg-surface-container-low p-4\">\n            <div class=\"pointer-events-none absolute -bottom-8 -right-8 opacity-15\">\n                <span class=\"material-symbols-outlined text-8xl text-ink\">map</span>\n            </div>\n\n            <div class=\"z-10 flex items-center justify-between\">\n                <div class=\"flex items-center gap-3\">\n                    <div class=\"flex size-10 items-center justify-center rounded-xl bg-surface-container text-on-surface-variant\">\n                        <span class=\"material-symbols-outlined\">location_on</span>\n                    </div>\n                    <div>\n                        <h3 class=\"text-lg font-semibold text-ink\">{{ __('Lokasi Saat Ini') }}</h3>\n                        <p class=\"text-sm text-on-surface-variant\" x-text=\"locationName\"></p>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-1.5 rounded-full border border-outline-variant bg-surface-container px-3 py-1 text-xs font-s