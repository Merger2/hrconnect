>\n                    <span x-text=\"buttonLabel()\"></span>\n                </button>\n            </div>\n        </div>\n    </template>\n</div>\n\n@push('scripts')\n<script>\n    function pointDistance(a, b) {\n        return Math.hypot(a.x - b.x, a.y - b.y);\n    }\n\n    function averagePoint(points) {\n        const total = points.reduce((carry, point) => ({\n            x: carry.x + point.x,\n            y: carry.y + point.y,\n        }), { x: 0, y: 0 });","truncated":true,"loaded":[],"display":{"type":"file","path":"/home/merger/hrconnect/resources/views/livewire/employee/face-enrollment.blade.php","text":"                    class=\"flex flex-1 items-center justify-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold transition\">\n                    <span class=\"material-symbols-outlined text-lg\">photo_camera</span>\n                    <span x-text=\"buttonLabel()\"></span>\n                </button>\n            </div>\n        </div>\n    </template>\n</div>\n\n@push('scripts')\n<script>\n    function pointDistance(a, b) {\n        return Math.hypot(a.x - b.x, a.y - b.y);\n    }\n\n    function averagePoint(points) {\n        const total = points.reduce((carry, point) => ({\n            x: carry.x + point.x,\n            y: carry.y + point.y,\n        }), { x: 0, y: 0 });\n        return { x: total.x / points.length, y: total.y / points.length };\n    }\n\n    function eyeAspectRatio(eye) {\n        const verticalA = pointDistance(eye[1], eye[5]);\n        const verticalB = pointDistance(eye[2], eye[4]);\n        const horizontal = pointDistance(eye[0], eye[3]);\n        return horizontal ? (verticalA + verticalB) / (2 * horizontal) : 0;\n    }\n","lineStart":90,"lineEnd":119,"totalLines":719,"truncated":true}},"title":"resources/views/livewire/employee/face-enrollment.blade.php","time":{"start":1783846297543,"end":1783846297561}},"id":"prt_f55865e5d00100pJS7EEMkWYyI","sessionID":"ses_0aa810585ffeak6Nm30GFjeCCh","messageID":"msg_f5586100f001Y3TUeHk68j1Ddg"}}
