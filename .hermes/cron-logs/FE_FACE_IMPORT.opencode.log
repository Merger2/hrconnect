{"type":"tool_use","timestamp":1783845822335,"sessionID":"ses_0aa810585ffeak6Nm30GFjeCCh","part":{"type":"tool","tool":"read","callID":"call_00_b3UrZiQc6z5caaPW83Xq4879","state":{"status":"completed","input":{"filePath":"/home/merger/hrconnect/resources/js/face-recognition.js"},"output":"<path>/home/merger/hrconnect/resources/js/face-recognition.js</path>\n<type>file</type>\n<content>\n1: import * as faceapi from 'face-api.js';\n2: \n3: const MODEL_URL = '/models/av1';\n4: \n5: const requiredNets = [\n6:     faceapi.nets.tinyFaceDetector,\n7:     faceapi.nets.faceLandmark68Net,\n8: ];\n9: \n10: export async function loadFaceModels() {\n11:     const loaded = await Promise.allSettled(\n12:         requiredNets.map(net => net.loadFromUri(MODEL_URL))\n13:     );\n14:     const failed = loaded.filter(r => r.status === 'rejected');\n15:     if (failed.length > 0) {\n16:         throw new Error(\n17:             'Gagal memuat model wajah: ' +\n18:             failed.map(r => r.reason?.message || 'unknown').join('; ')\n19:         );\n20:     }\n21: }\n22: \n23: export function computeEAR(landmarks) {\n24:     const leftEye = landmarks.getLeftEye();\n25:     const rightEye = landmarks.getRightEye();\n26: \n27:     const leftEAR = (\n28:         dist(leftEye[1], leftEye[5]) + dist(leftEye[2], leftEye[4])\n29:     ) / (2 * dist(leftEye[0], leftEye[3]));\n30: \n31:     const rightEAR = (\n32:         dist(rightEye[1], rightEye[5]) + dist(rightEye[2], rightEye[4])\n33:     ) / (2 * dist(rightEye[0], rightEye[3]));\n34: \n35:     return (leftEAR + rightEAR) / 2;\n36: }\n37: \n38: function dist(a, b) {\n39:     return Math.sqrt((a.x - b.x) ** 2 + (a.y - b.y) ** 2);\n40: }\n41: \n42: export function computeDescriptorVariance(descriptors) {\n43:     if (descriptors.length < 2) return 0;\n44:     const n = descriptors.length;\n45:     const dim = descriptors[0].length;\n46:     let sum = 0;\n47:     let count = 0;\n48:     for (let i = 0; i < n; i++) {\n49:         for (let j = i + 1; j < n; j++) {\n50:             let d = 0;\n51:             for (let k = 0; k < dim; k++) {\n52:                 d += (descriptors[i][k] - descriptors[j][k]) ** 2;\n53:             }\n54:             sum += Math.sqrt(d);\n55:             count++;\n56:         }\n57:     }\n58:     return sum / count;\n59: }\n60: \n61: export function euclideanDistance(a, b) {\n62:     let sum = 0;\n63:     for (let i = 0; i < a.length; i++) {\n64:         sum += (a[i] - b[i]) ** 2;\n65:     }\n66:     return Math.sqrt(sum);\n67: }\n68: \n69: export { faceapi, MODEL_URL };\n\n(End of file - total 69 lines)\n</content>","metadata":{"preview":"import * as faceapi from 'face-api.js';\n\nconst MODEL_URL = '/models/av1';\n\nconst requiredNets = [\n    faceapi.nets.tinyFaceDetector,\n    faceapi.nets.faceLandmark68Net,\n];\n\nexport async function loadFaceModels() {\n    const loaded = await Promise.allSettled(\n        requiredNets.map(net => net.loadFromUri(MODEL_URL))\n    );\n    const failed = loaded.filter(r => r.status === 'rejected');\n    if (failed.length > 0) {\n        throw new Error(\n            'Gagal memuat model wajah: ' +\n            failed.map(r => r.reason?.message || 'unknown').join('; ')\n        );\n    }","truncated":false,"loaded":[],"display":{"type":"file","path":"/home/merger/hrconnect/resources/js/face-recognition.js","text":"import * as faceapi from 'face-api.js';\n\nconst MODEL_URL = '/models/av1';\n\nconst requiredNets = [\n    faceapi.nets.tinyFaceDetector,\n    faceapi.nets.faceLandmark68Net,\n];\n\nexport async function loadFaceModels() {\n    const loaded = await Promise.allSettled(\n        requiredNets.map(net => net.loadFromUri(MODEL_URL))\n    );\n    const failed = loaded.filter(r => r.status === 'rejected');\n    if (failed.length > 0) {\n        throw new Error(\n            'Gagal memuat model wajah: ' +\n            failed.map(r => r.reason?.message || 'unknown').join('; ')\n        );\n    }\n}\n\nexport function computeEAR(landmarks) {\n    const leftEye = landmarks.getLeftEye();\n    const rightEye = landmarks.getRightEye();\n\n    const leftEAR = (\n        dist(leftEye[1], leftEye[5]) + dist(leftEye[2], leftEye[4])\n    ) / (2 * dist(leftEye[0], leftEye[3]));\n\n    const rightEAR = (\n        dist(rightEye[1], rightEye[5]) + dist(rightEye[2], rightEye[4])\n    ) / (2 * dist(rightEye[0], rightEye[3]));\n\n    return (leftEAR + rightEAR) / 2;\n}\n\nfunction dist(a, b) {\n    return Math.sqrt((a.x - b.x) ** 2 + (a.y - b.y) ** 2);\n}\n\nexport function computeDescriptorVariance(descriptors) {\n    if (descriptors.length < 2) return 0;\n    const n = descriptors.length;\n    const dim = descriptors[0].length;\n    let sum = 0;\n    let count = 0;\n    for (let i = 0; i < n; i++) {\n        for (let j = i + 1; j < n; j++) {\n            let d = 0;\n            for (let k = 0; k < dim; k++) {\n                d += (descriptors[i][k] - descriptors[j][k]) ** 2;\n            }\n            sum += Math.sqrt(d);\n            count++;\n        }\n    }\n    return sum / count;\n}\n\nexport function euclideanDistance(a, b) {\n    let sum = 0;\n    for (let i = 0; i < a.length; i++) {\n        sum += (a[i] - b[i]) ** 2;\n    }\n    return Math.sqrt(sum);\n}\n\nexport { faceapi, MODEL_URL };","lineStart":1,"lineEnd":69,"totalLines":69,"truncated":false}},"title":"resources/js/face-recognition.js","time":{"start":1783845822321,"end":1783845822333}},"id":"prt_f557f1e96001uEjgJgifCdDHpa","sessionID":"ses_0aa810585ffeak6Nm30GFjeCCh","messageID":"msg_f557f15b9001g2IOwCthhpTGHU"}}
