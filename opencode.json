{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "laravel-boost": {
      "type": "local",
      "enabled": true,
      "command": [
        "php",
        "artisan",
        "boost:mcp"
      ]
    }
  },
  "provider": {
    "chenzk": {
      "name": "Chenzk API",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://www.chenzk.top/v1",
         "apiKey": "YOUR_CHENZK_API_KEY_HERE"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.5-openai-compact": {
          "name": "GPT 5.5 Open AI Compact",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.4": {
          "name": "GPT 5.4",
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini",
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}