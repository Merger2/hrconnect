# ============================================================
# HRConnect — .env PRODUCTION (template)
# ============================================================
# Cara pakai:
#   cp .env.production.example .env   # DI SERVER PRODUKSI (bukan di repo!)
#   nano .env                         # isi semua nilai di bawah
#   php artisan key:generate --force  # APP_KEY baru — JANGAN pakai key dev
#
# ⚠️ JANGAN commit file ini dengan nilai terisi. Semua nilai di bawah
#    adalah PLACEHOLDER — ganti dengan nilai asli di server.
# ⚠️ Baca & eksekusi deploy/ROTATION-RUNBOOK.md + docs/SECURITY-CHECKLIST.md
#    §1 SEBELUM deploy (rotasi DB_PASSWORD, APP_KEY, MAIL_PASSWORD, dst).
# ============================================================

APP_NAME="HRConnect"
# WAJIB production: BUKAN local
APP_ENV=production
# WAJIB: key baru di server (php artisan key:generate --force)
APP_KEY=
# Opsional: key lama untuk transisi (dipisah koma) — lihat ROTATION-RUNBOOK §2
APP_PREVIOUS_KEYS=
# WAJIB production: false — true = stack trace + env bocor
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID
# WAJIB: domain HTTPS final, tanpa trailing slash
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=2
ARGON_TIME=4

# Production: daily + info (bukan single + debug)
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ============================================================
# Database (PostgreSQL 15+ — WAJIB pgvector + pg_trgm + pgcrypto)
# ============================================================
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hrconnect
DB_USERNAME=hrconnect_app
# 🔴 WAJIB rotasi — password asli pernah di history git (commit 6a24cc4).
#    Setelah rotasi, verifikasi via hash pg_authid (bukan coba-connect).
#    Produksi WAJIB scram-sha-256 di pg_hba.conf (bukan trust/md5).
DB_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR
# Role khusus drill restore (maintenance:backup-restore-drill) — privilege
# CREATEDB, BUKAN superuser. Harus bisa CREATE DATABASE + restore (extension
# vector/pgcrypto/pg_trgm ter-install di template1 oleh superuser saat setup).
DB_DRILL_USERNAME=drill_hrconnect
DB_DRILL_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR
# Retensi artefak backup terjadwal (hari)
BACKUP_RETENTION_DAYS=14
# Maks umur backup sebelum /api/v1/health melaporkan degraded (default 26 jam)
BACKUP_MAX_AGE_HOURS=26
# WAJIB bila DB di host terpisah; prefer bila satu mesin
DB_SSLMODE=require

# ============================================================
# Session / Cache / Queue / Broadcasting
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB: cookie hanya via HTTPS
SESSION_SECURE_COOKIE=true
# false = multi-device diizinkan (keputusan Fikih 2026-08-16)
AUTH_SINGLE_DEVICE=false

# BROADCAST_CONNECTION=log  → realtime nonaktif (default, paling simpel)
# BROADCAST_CONNECTION=reverb → aktifkan Reverb (lihat deploy/README.md §1)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# WAJIB dengan supervisor aktif — matikan fallback queue:work tiap menit
SCHEDULE_QUEUE_WORKER=false
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
DB_CACHE_TABLE=cache
# wajib cache_locks (bukan cache) — fix 2026-08-12: lock gagal bila pakai tabel cache
DB_CACHE_LOCK_TABLE=cache_locks

# ============================================================
# Backup (spatie/laravel-backup)
# ============================================================
BACKUP_DISK=backups
# 🔴 WAJIB isi: password kuat untuk arsip backup terenkripsi
BACKUP_ARCHIVE_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR

# ============================================================
# Mail (WAJIB smtp — bukan log — di production)
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=GANTI_USERNAME
# 🔴 WAJIB rotasi — kredensial SMTP pernah ada di history git
MAIL_PASSWORD=GANTI_PASSWORD
# WAJIB: alamat pengirim resmi (bukan hello@example.com)
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# Storage / PWA
# ============================================================
# Opsional: S3/object storage untuk payslip/foto bila perlu (lihat README)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# Enkripsi PII (Ciphersweet) — WAJIB 64-char hex
# ============================================================
# Generate: php artisan ciphersweet:generate-key
# 🔴 JANGAN pakai key dev — generate baru di server. Rotasi key lama →
#    data terenkripsi lama tetap terbaca via APP_PREVIOUS_KEYS (lihat
#    docs/SECURITY-CHECKLIST.md pelajaran re-encrypt PII setelah rotasi).
CIPHERSWEET_KEY=GANTI_64CHAR_HEX

# Activity log
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false

# Audit log
API_VERSION=1.0.0

# Sanctum SPA auth
SANCTUM_STATEFUL_DOMAINS=your-domain.com
SANCTUM_TOKEN_PREFIX=

# ============================================================
# HRConnect config
# ============================================================
FACE_DISTANCE_THRESHOLD=0.15
GEOFENCE_DEFAULT_RADIUS=100

# ============================================================
# AI / RAG (Gemini)
# ============================================================
# GOOGLE_AI_API_KEY legacy — kosongkan di produksi
GOOGLE_AI_API_KEY=
# 🟠 WAJIB: key PRODUKSI (bukan key dev). Aktifkan billing bila kuota 20/hari
#    tidak cukup (free tier per model).
GEMINI_API_KEY=GANTI_KEY_PRODUKSI
# false = pendaftaran mandiri nonaktif di produksi
FORTIFY_REGISTRATION_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
# 768D via output_dimensionality
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3
# Cost limit AI (hard gate): batas token per hari untuk semua pipeline Gemini.
# Tetapkan budget eksplisit (mis. 1000000 = 1M token/hari) + alert di provider.
AI_DAILY_TOKEN_BUDGET=1000000

# ============================================================
# Super Admin bootstrap (SuperAdminSeeder — jalankan SEKALI di server)
# ============================================================
# WAJIB ganti SUPER_ADMIN_PASSWORD setelah login pertama via Force Change Password.
SUPER_ADMIN_EMAIL=admin@your-domain.com
# Generate: php artisan tinker --execute='echo \Illuminate\Support\Str::password()'
SUPER_ADMIN_PASSWORD=GANTI_PASSWORD_STRONG
SUPER_ADMIN_NAME="Super Admin"

# Demo VPS (skripsi): izinkan seeder demo berjalan walau APP_ENV=production.
# Default false = guard produksi aktif (jangan ubah kecuali memang VPS demo).
# Demo penuh: SEED_DEMO=true SEED_YEAR_ONE=true php artisan db:seed --force
SEED_DEMO=false

# ============================================================
# 🔴 VERIFIKASI FINAL — semua harus terisi benar sebelum traffic dibuka
# ============================================================
# 1. APP_ENV=production      ✅
# 2. APP_DEBUG=false         ✅ (curl /tidak-ada → tanpa Whoops/stack trace)
# 3. APP_URL=https://...     ✅
# 4. SESSION_SECURE_COOKIE=true  ✅
# 5. DB_PASSWORD + DB_DRILL_* dirotasi + scram-sha-256  ✅
# 6. MAIL_MAILER=smtp + password dirotasi  ✅
# 7. GEMINI_API_KEY produksi  ✅
# 8. BACKUP_ARCHIVE_PASSWORD terisi  ✅
# 9. CIPHERSWEET_KEY baru 64-char hex  ✅
# 10. php artisan config:cache dijalankan SETELAH .env final  ✅
