# ============================================================
# HRConnect - .env PRODUCTION (template)
# ============================================================
# Cara pakai:
#   cp .env.production.example .env   # DI SERVER PRODUKSI (bukan di repo!)
#   nano .env                         # isi semua nilai di bawah
#   php artisan key:generate --force  # APP_KEY baru - JANGAN pakai key dev
#
# JANGAN commit file ini dengan nilai terisi. Semua nilai di bawah
# adalah PLACEHOLDER - ganti dengan nilai asli di server.
# Baca & eksekusi deploy/ROTATION-RUNBOOK.md + docs/SECURITY-CHECKLIST.md
# sebelum deploy (rotasi DB_PASSWORD, APP_KEY, MAIL_PASSWORD, dst).
# ============================================================

APP_NAME="HRConnect"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=2
ARGON_TIME=4

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL 15+ with pgvector, pg_trgm, and pgcrypto extensions.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hrconnect
DB_USERNAME=hrconnect_app
DB_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR
# Dedicated restore-drill role with CREATEDB privilege, not superuser.
DB_DRILL_USERNAME=drill_hrconnect
DB_DRILL_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=26
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
AUTH_SINGLE_DEVICE=false

# Use reverb only after its supervisor process and proxy are configured.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SCHEDULE_QUEUE_WORKER=false
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
INDONESIA_CACHE_STORE=database

BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=GANTI_PASSWORD_STRONG_32+_CHAR

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=GANTI_USERNAME
MAIL_PASSWORD=GANTI_PASSWORD
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Generate with: php artisan ciphersweet:generate-key
CIPHERSWEET_KEY=GANTI_64CHAR_HEX

ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false
API_VERSION=1.0.0

SANCTUM_STATEFUL_DOMAINS=your-domain.com
SANCTUM_TOKEN_PREFIX=

FACE_DISTANCE_THRESHOLD=0.15
GEOFENCE_DEFAULT_RADIUS=100

# GOOGLE_AI_API_KEY is legacy. Keep it empty in production.
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=GANTI_KEY_PRODUKSI
FORTIFY_REGISTRATION_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3
AI_DAILY_TOKEN_BUDGET=1000000

# SuperAdminSeeder requires a non-empty password in production.
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=GANTI_PASSWORD_STRONG
SUPER_ADMIN_NAME="Super Admin"

# Keep false unless this is an explicit demo VPS.
SEED_DEMO=false
