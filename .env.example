APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
# PRODUCTION: set APP_DEBUG=false to prevent stack trace leaks
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_URL=http://localhost
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_THREADS=2
ARGON_TIME=4

LOG_CHANNEL=stack
# PRODUCTION: LOG_CHANNEL=daily, LOG_LEVEL=info
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hrconnect
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database

# Backup (spatie/laravel-backup)
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Encryption (64-char hex, generated via php artisan ciphersweet:generate-key)
CIPHERSWEET_KEY=

# Activity log
ACTIVITYLOG_ENABLED=true
ACTIVITYLOG_BUFFER_ENABLED=false

# Audit log
API_VERSION=1.0.0

# Sanctum SPA auth
SANCTUM_STATEFUL_DOMAINS=localhost:8000
SANCTUM_TOKEN_PREFIX=

# HRConnect config
FACE_DISTANCE_THRESHOLD=0.15
GEOFENCE_DEFAULT_RADIUS=100

# AI/RAG
# GOOGLE_AI_API_KEY is legacy; GEMINI_API_KEY is preferred by laravel/ai SDK
# Set either one — config falls back from GEMINI_API_KEY to GOOGLE_AI_API_KEY
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
# Set false in production to disable self-registration
FORTIFY_REGISTRATION_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3
# Set true untuk demo offline (KnowledgeBase mock response, no API call)
RAG_MOCK_MODE=false

# Super Admin bootstrap (untuk SuperAdminSeeder)
# WAJIB ganti SUPER_ADMIN_PASSWORD setelah login pertama via Force Change Password.
SUPER_ADMIN_EMAIL=admin@hrconnect.local
SUPER_ADMIN_PASSWORD=ChangeMe!2026
SUPER_ADMIN_NAME="Super Admin"

# ───── PRODUCTION OVERRIDES ─────
# Uncomment and set these on production:
# APP_ENV=production
# APP_DEBUG=false
# LOG_CHANNEL=daily
# LOG_LEVEL=info
# SESSION_SECURE_COOKIE=true
# SANCTUM_EXPIRATION=525600
