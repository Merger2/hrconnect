{
  "_meta": {
    "description": "Golden test dataset PayrollCalculatorService — angka referensi diisi dari perhitungan manual/konsultan pajak Fikih. Jangan isi expected dengan angka tebakan; setiap case harus diverifikasi dari sumber referensi.",
    "sumber_referensi": "excel perhitungan manual Fikih / konsultan pajak / contoh resmi pajak.go.id",
    "cara_mengisi": "1) isi expected (angka per komponen) 2) set active=true 3) catat sumber di reference 4) jalankan vendor/bin/pest tests/Feature/PayrollGoldenTest.php",
    "catatan_kalkulasi": [
      "prorated_salary = (hari_kerja_aktual / hari_kerja_bulan) x (basic_salary + allowance_jabatan), kalender 5 hari kerja (ManagesWorkDays)",
      "overtime weekday: jam-1 = 1.5x, jam-2+ = 2x hourly; holiday/weekend: 1-8 = 2x, 9-10 = 3x, 11+ = 4x; hourly = (basic+allowance)/173",
      "late_penalty = jumlah_hari_late x penalty_per_day (default 50000, CompanySetting attendance_penalty_per_day)",
      "alpha_penalty = jumlah_alpha x (basic_salary / hari_kerja_bulan)",
      "bpjs dihitung dari taxable_income = prorata + lembur (reimbursement TIDAK kena pajak/BPJS)",
      "pph21 TER bulanan = bruto kena pajak x tarif TER (tabel tarif_ter, kategori A/B/C)",
      "Desember/bulan terminasi: true-up annual progressive Pasal 17 (PP 58/2023), pph21 = max(0, annual_pph21 - ytd)",
      "net_salary = gross_salary - (attendance_penalty + bpjs_health_employee + bpjs_jht_employee + bpjs_jp_employee + pph21)",
      "gross_salary = prorated_salary + overtime_pay + reimbursement"
    ],
    "periode_referensi": "2026-07 (harus periode non-Desember untuk kasus TER bulanan)",
    "data_yang_harus_ter-seed_sebelum_test": "TarifTerSeeder + PayrollConfigSeeder (BpjsConfig) + CompanySetting attendance_penalty_per_day",
    "referensi_tarif_bpjs_2025": [
      "Kesehatan: employer 4%, employee 1%, ceiling 12.000.000 (dihitung dari min(gross, ceiling))",
      "JHT: employer 3.7%, employee 2%, tanpa ceiling",
      "JP: employer 2%, employee 1%, ceiling 9.559.600",
      "JKK: employer 0.24%, employee 0%, tanpa ceiling",
      "JKM: employer 0.3%, employee 0%, tanpa ceiling",
      "Sumber: database/seeders/PayrollConfigSeeder.php"
    ],
    "referensi_tarif_ter": "Tabel TER bulanan PP 58/2023 kategori A/B/C ada di database/seeders/TarifTerSeeder.php (kategori_ter di-seed migration). Kategori A: 0% s/d bruto 5.400.000, dst; B: 0% s/d 6.200.000; C: 0% s/d 6.600.000. Contoh untuk PR-01 (bruto 7.000.000, kategori A): bracket 6.750.001-7.500.000 = 1.25%.",
    "formula_dari_payrollcalculator": [
      "prorated = round((hari_kerja_aktual/hari_kerja_bulan) x (basic+allowance), 2)",
      "hourly_rate = (basic+allowance)/173; lembur weekday jam-1 1.5x jam-2+ 2x; weekend/holiday 1-8 2x, 9-10 3x, 11+ 4x",
      "late_penalty = late_days x penalty_per_day; alpha_penalty = alpha_days x (basic/hari_kerja_bulan)",
      "taxable_income = prorata + lembur (reimbursement TIDAK dipajaki/tidak kena BPJS)",
      "pph21_ter = (taxable - attendance_penalty) x tarif_ter",
      "Desember/bulan terminasi: pph21 = max(0, annual_progressive(ytd_gross + gross) - ytd_pph21)",
      "bpjs dihitung dari taxable_income; deductions = attendance_penalty + kesehatan(1%) + jht(2%) + jp(1%) + pph21",
      "net = gross - deductions; gross = prorata + lembur + reimbursement"
    ]
  },
